{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CorePro",
  "version": "0.1.0",
  "identifier": "dev.soab.corepro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CorePro",
        "width": 1400,
        "height": 900,
        "minWidth": 860,
        "minHeight": 560,
        "backgroundColor": "#0e0f11",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' cs: http://cs.localhost data: blob:; media-src 'self' cs: http://cs.localhost blob:; connect-src 'self' ipc: http://ipc.localhost cs: http://cs.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Files, photos and video in one app",
    "resources": ["resources/music/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
